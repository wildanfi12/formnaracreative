# Nara Creative Website - .gitignore

# Mac files
.DS_Store

# Windows files
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Backup files
*.bak
*.backup
*_backup.*

# Test files (if any)
test.html
test-*.html

# Environment files (if you add any API keys in the future)
.env
.env.local

# Node modules (if you add build tools later)
node_modules/
package-lock.json
yarn.lock

# Build outputs (if you add build process later)
dist/
build/

# Temporary files
*.tmp
temp/

# Apps Script - DO NOT commit credentials
# (apps-script-backend.gs is safe to commit, it has no credentials)
